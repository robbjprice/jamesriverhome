  color: var(--uc-red);
  font-size: 12px;
  font-weight: 850;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}

.publication-group[open] .publication-group-header::after {
  content: "Click to collapse";
}

.publication-group:not([open]) .publication-list-academic {
  display: none;
}
